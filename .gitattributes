# The repo stores LF; working trees may check out whatever the platform wants.
# Without this, a contributor on Windows can turn a one-line change into a
# whole-file diff.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated. Collapsed in review and excluded from language stats.
package-lock.json linguist-generated=true -diff
