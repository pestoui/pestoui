{
  "name": "@pestoui/core",
  "version": "0.1.0",
  "description": "A warm-neutral React design system for agent and dashboard products — every shadcn/ui primitive restyled to one coherent language, plus a full application-UI set. Tailwind v4, React 19, Radix.",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "tailwind-v4",
    "radix-ui",
    "shadcn",
    "components",
    "ui",
    "dashboard"
  ],
  "license": "MIT",
  "author": "Fahim Anando <fahim.anando@gmail.com>",
  "homepage": "https://pestoui.com",
  "bugs": "https://github.com/pestoui/pestoui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pestoui/pestoui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "components.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/index.css",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./ui": "./src/components/ui/index.ts",
    "./ui/*": "./src/components/ui/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./theme": "./src/lib/theme/index.ts",
    "./components.json": "./components.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "gen:barrel": "node scripts/gen-barrel.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2"
  },
  "private": true
}
